/* =========================================================
 *  main
 * ========================================================= */
int main(void)
{
    char input[MAX_LEN];
    char targetLine[MAX_LEN];
    char skewed[100];
    char growthNames[4][20];
    int growthN[4] = {5, 10, 15, 20};
    Node *root;
    int ok, i;
    MemResult userRes, results[3], growth[4];

    /* 1. 이진트리 입력 */
    printf("이진트리를 괄호 표기법으로 입력하세요 (예: A(B,C(D,E))): ");
    if (fgets(input, MAX_LEN, stdin) == NULL) {
        printf("입력 오류\n");
        return 1;
    }
    removeNewline(input);
    removeSpaces(input);

    if (hasDuplicate(input)) {
        printf("오류: 같은 노드 이름이 두 번 이상 사용되었습니다.\n");
        printf("올바르지 않은 입력입니다.\n");
        return 1;
    }

    /* 2. 배열 기반 이진트리 생성 */
    if (!buildArrayTree(input, &userArray)) {
        printf("올바르지 않은 입력입니다.\n");
        return 1;
    }
    printf("\n[배열 기반 이진트리]\n");
    printArrayContents(&userArray);
    printArrayTree(&userArray, 1, 0);

    /* 3. 연결 자료구조 기반 이진트리 생성 */
    root = buildLinkedTree(input, &ok);
    if (!ok) {
        printf("올바르지 않은 입력입니다.\n");
        return 1;
    }
    printf("\n[연결 자료구조 기반 이진트리]\n");
    printLinkedTree(root, 0);

    /* 4. 입력한 트리의 메모리 사용량 */
    fillResult(&userRes, "입력한 트리", &userArray, root);
    printMemoryDetail(&userRes);

    /* 5. 일반 / 완전 / 편향 이진트리 메모리 비교 (모두 노드 15개) */
    makeSkewedString(skewed, SAMPLE_N);
    if (!measureTree("일반 이진트리", SAMPLE_GENERAL, &results[0]) ||
        !measureTree("완전 이진트리", SAMPLE_COMPLETE, &results[1]) ||
        !measureTree("편향 이진트리", skewed, &results[2])) {
        printf("예제 트리 생성에 실패했습니다.\n");
        freeTree(root);
        return 1;
    }

    printf("\n==================================================\n");
    printf(" 일반 / 완전 / 편향 이진트리 메모리 비교 (노드 %d개)\n", SAMPLE_N);
    printf("==================================================\n");
    for (i = 0; i < 3; i++) {
        printMemoryDetail(&results[i]);
    }

    printf("\n[메모리 비교표]  (배열/연결 < 1 이면 배열이 더 작음)\n");
    printTable(results, 3);

    /* 편향 트리에서 노드 수에 따른 변화 */
    for (i = 0; i < 4; i++) {
        makeSkewedString(skewed, growthN[i]);
        snprintf(growthNames[i], sizeof(growthNames[i]), "편향(n=%d)", growthN[i]);
        if (!measureTree(growthNames[i], skewed, &growth[i])) {
            printf("편향 트리 생성에 실패했습니다.\n");
            freeTree(root);
            return 1;
        }
    }
    printf("\n[편향 이진트리: 노드 수에 따른 메모리 변화]\n");
    printTable(growth, 4);

    /* 6. 찾을 노드 입력 */
    printf("\n찾을 노드를 입력하세요 (영문 대문자 한 글자): ");
    targetLine[0] = '\0';
    if (fgets(targetLine, MAX_LEN, stdin) != NULL) {
        removeNewline(targetLine);
        removeSpaces(targetLine);
    }

    if (strlen(targetLine) == 1 && isNodeChar(targetLine[0])) {
        printf("\n");
        showRelationArray(&userArray, targetLine[0]);   /* 7. 배열 구현 */
        printf("\n\n");
        showRelationLinked(root, targetLine[0]);        /* 8. 연결 구현 */
    } else {
        printf("\n노드 이름은 영문 대문자 한 글자여야 합니다. 노드 탐색은 건너뜁니다.\n");
    }

    /* 9. 두 구현의 차이 분석 */
    printAnalysis(&results[0], &results[1], &results[2], growth);

    freeTree(root);
    return 0;
}
