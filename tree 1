/*
 * 과제: 배열을 이용한 이진트리 구현
 *
 * - 괄호 표기법 문자열을 입력받아 배열에 저장한다.
 * - 배열 인덱스는 1번부터 사용한다.
 *     부모 인덱스 i  ->  왼쪽 자식: 2*i, 오른쪽 자식: 2*i+1
 * - 노드가 없는 위치는 0('\0')으로 비워 둔다.
 *   (그래서 A(,B) 의 B는 반드시 인덱스 3에 저장된다.)
 */

#include <stdio.h>
#include <string.h>
#include <ctype.h>

#define MAX_SIZE 1048576   /* 배열 크기 (2^20) : 최대 20레벨까지 저장 가능 */
#define MAX_LEN  1000      /* 입력 문자열 최대 길이 */

char tree[MAX_SIZE];       /* 이진트리를 저장하는 배열 (전역 배열은 0으로 초기화됨) */
int  maxIndex = 0;         /* 사용된 가장 큰 인덱스 */
int  parseError = 0;       /* 파싱 중 오류가 생기면 1 */
int  pos = 0;              /* 입력 문자열에서 현재 읽고 있는 위치 */
char input[MAX_LEN];       /* 입력 문자열 */

/* ---------------------------------------------------------
 * 보조 함수: i번 노드의 왼쪽/오른쪽 자식이 있는지 검사
 * (배열 범위를 벗어나면 자식이 없는 것으로 처리)
 * --------------------------------------------------------- */
int hasLeft(int i)
{
    return (2 * i < MAX_SIZE && tree[2 * i] != 0);
}

int hasRight(int i)
{
    return (2 * i + 1 < MAX_SIZE && tree[2 * i + 1] != 0);
}

/* ---------------------------------------------------------
 * 입력 문자열 처리
 * --------------------------------------------------------- */

/* 문자열 끝의 개행 문자('\n', '\r')를 제거한다. */
void removeNewline(char *s)
{
    int len = strlen(s);
    while (len > 0 && (s[len - 1] == '\n' || s[len - 1] == '\r')) {
        s[len - 1] = '\0';
        len--;
    }
}

/* 문자열 속의 공백 문자를 모두 제거한다. */
void removeSpaces(char *s)
{
    int r, w = 0;
    for (r = 0; s[r] != '\0'; r++) {
        if (!isspace((unsigned char)s[r])) {
            s[w++] = s[r];
        }
    }
    s[w] = '\0';
}

/* 현재 위치의 문자가 노드 이름(영문 대문자)인지 검사 */
int isNodeChar(char c)
{
    return (c >= 'A' && c <= 'Z');
}

/* ---------------------------------------------------------
 * 괄호 표기법 파싱 (재귀)
 *
 * 문법:  노드 ::= 대문자 [ '(' [노드] ',' [노드] ')' ]
 *
 * index : 이 노드를 저장할 배열 위치
 * 왼쪽 자식은 2*index, 오른쪽 자식은 2*index+1 에 저장한다.
 * 쉼표 앞이 비어 있으면 왼쪽 자식이 없는 것이고,
 * 쉼표 뒤가 비어 있으면 오른쪽 자식이 없는 것이다.
 * --------------------------------------------------------- */
void parseNode(int index)
{
    int hasLeftChild = 0, hasRightChild = 0;

    if (parseError) return;

    /* 배열 크기를 넘어가는 경우 */
    if (index >= MAX_SIZE) {
        printf("오류: 트리가 너무 깊어 배열에 저장할 수 없습니다.\n");
        parseError = 1;
        return;
    }

    /* 1) 노드 이름 읽기 */
    if (!isNodeChar(input[pos])) {
        printf("오류: 노드 이름(영문 대문자)이 필요합니다. (위치 %d)\n", pos + 1);
        parseError = 1;
        return;
    }
    tree[index] = input[pos];
    if (index > maxIndex) maxIndex = index;
    pos++;

    /* 2) 괄호가 없으면 단말 노드 */
    if (input[pos] != '(') return;
    pos++;   /* '(' 건너뜀 */

    /* 3) 왼쪽 자식: 바로 대문자가 나오면 왼쪽 자식이 있다 */
    if (isNodeChar(input[pos])) {
        hasLeftChild = 1;
        parseNode(2 * index);
        if (parseError) return;
    }
    /* 아니면 왼쪽 자식이 비어 있는 것 -> 그대로 넘어감 (자리는 비워 둠) */

    /* 4) 쉼표 */
    if (input[pos] != ',') {
        printf("오류: ',' 가 필요합니다. (위치 %d)\n", pos + 1);
        parseError = 1;
        return;
    }
    pos++;   /* ',' 건너뜀 */

    /* 5) 오른쪽 자식 */
    if (isNodeChar(input[pos])) {
        hasRightChild = 1;
        parseNode(2 * index + 1);
        if (parseError) return;
    }

    /* 6) 닫는 괄호 */
    if (input[pos] != ')') {
        printf("오류: ')' 가 필요합니다. (위치 %d)\n", pos + 1);
        parseError = 1;
        return;
    }
    pos++;   /* ')' 건너뜀 */

    /* A(,) 처럼 괄호 안이 완전히 비어 있는 경우는 잘못된 입력 */
    if (!hasLeftChild && !hasRightChild) {
        printf("오류: 괄호 안에 자식이 하나도 없습니다.\n");
        parseError = 1;
    }
}

/* 전체 문자열을 파싱한다. 성공하면 1, 실패하면 0 반환 */
int buildTree(void)
{
    pos = 0;
    parseError = 0;
    maxIndex = 0;

    parseNode(1);   /* 루트는 인덱스 1 */

    if (!parseError && input[pos] != '\0') {
        printf("오류: 입력 끝에 잘못된 문자가 있습니다. (위치 %d)\n", pos + 1);
        parseError = 1;
    }
    return !parseError;
}

/* ---------------------------------------------------------
 * [1] 이진트리 출력 (왼쪽으로 눕힌 형태)
 *
 * 오른쪽 자식 -> 자기 자신 -> 왼쪽 자식 순서로 출력하면
 * 트리를 왼쪽으로 90도 눕힌 모양이 된다.
 * (오른쪽 서브트리가 위, 왼쪽 서브트리가 아래에 나온다.)
 * 레벨이 하나 깊어질 때마다 4칸씩 들여쓴다.
 * --------------------------------------------------------- */
void printTree(int i, int level)
{
    int k;

    if (i >= MAX_SIZE || tree[i] == 0) return;

    printTree(2 * i + 1, level + 1);   /* 오른쪽 서브트리 */

    for (k = 0; k < level; k++) {
        printf("    ");
    }
    printf("%c\n", tree[i]);           /* 현재 노드 */

    printTree(2 * i, level + 1);       /* 왼쪽 서브트리 */
}

/* ---------------------------------------------------------
 * [2] 트리 정보
 * --------------------------------------------------------- */

/* 전체 노드 수 */
int countNodes(void)
{
    int i, count = 0;
    for (i = 1; i <= maxIndex; i++) {
        if (tree[i] != 0) count++;
    }
    return count;
}

/* 단말 노드 수 : 자식이 하나도 없는 노드 */
int countLeaves(void)
{
    int i, count = 0;
    for (i = 1; i <= maxIndex; i++) {
        if (tree[i] != 0 && !hasLeft(i) && !hasRight(i)) count++;
    }
    return count;
}

/*
 * 트리의 높이 (재귀)
 * [높이 기준] 루트를 레벨 1로 보고, 가장 깊은 노드의 레벨을 높이로 한다.
 *            (노드가 루트 하나뿐이면 높이 = 1)
 */
int getHeight(int i)
{
    int leftH, rightH;

    if (i >= MAX_SIZE || tree[i] == 0) return 0;

    leftH  = getHeight(2 * i);
    rightH = getHeight(2 * i + 1);

    return 1 + (leftH > rightH ? leftH : rightH);
}

/* 트리의 차수 : 모든 노드 중 자식 수가 가장 많은 값 (이진트리이므로 최대 2) */
int getDegree(void)
{
    int i, childCount, degree = 0;
    for (i = 1; i <= maxIndex; i++) {
        if (tree[i] == 0) continue;
        childCount = 0;
        if (hasLeft(i))  childCount++;
        if (hasRight(i)) childCount++;
        if (childCount > degree) degree = childCount;
    }
    return degree;
}

/* ---------------------------------------------------------
 * [3] 이진트리 형태 판별
 * --------------------------------------------------------- */

/*
 * 완전 이진트리 판별
 * 배열의 1번부터 마지막 노드까지 훑으면서,
 * 빈 칸이 한 번 나온 뒤에 다시 노드가 나오면 완전 이진트리가 아니다.
 */
int isComplete(void)
{
    int i;
    int foundEmpty = 0;

    for (i = 1; i <= maxIndex; i++) {
        if (tree[i] == 0) {
            foundEmpty = 1;
        } else if (foundEmpty) {
            return 0;   /* 빈 칸 뒤에 노드가 또 나옴 */
        }
    }
    return 1;
}

/*
 * 포화 이진트리 판별 (재귀 확인)
 * - 자식이 없는 노드(단말)는 반드시 마지막 레벨(height)에 있어야 한다.
 * - 자식이 있는 노드는 반드시 왼쪽, 오른쪽 자식을 모두 가져야 한다.
 */
int checkFull(int i, int level, int height)
{
    int l = hasLeft(i);
    int r = hasRight(i);

    if (!l && !r) {                 /* 단말 노드 */
        return (level == height);   /* 마지막 레벨에 있어야 함 */
    }
    if (l && r) {                   /* 자식이 둘 다 있음 */
        return checkFull(2 * i, level + 1, height) &&
               checkFull(2 * i + 1, level + 1, height);
    }
    return 0;                       /* 자식이 하나뿐인 노드가 있음 */
}

int isFull(void)
{
    int height = getHeight(1);
    int expected;

    /* 노드 수가 2^h - 1 인지 먼저 확인 (1 << h 는 2의 h제곱) */
    expected = (1 << height) - 1;
    if (countNodes() != expected) return 0;

    /* 실제 구조도 확인 */
    return checkFull(1, 1, height);
}

/*
 * 편향 이진트리 판별
 * 왼쪽과 오른쪽 자식을 동시에 가진 노드가 하나라도 있으면 편향이 아니다.
 * (모든 노드가 자식을 최대 1개만 가지면 편향 이진트리)
 */
int isSkewed(void)
{
    int i;
    for (i = 1; i <= maxIndex; i++) {
        if (tree[i] != 0 && hasLeft(i) && hasRight(i)) return 0;
    }
    return 1;
}

/* YES / NO 문자열로 바꿔 주는 함수 */
const char *yesNo(int value)
{
    return value ? "YES" : "NO";
}

/* ---------------------------------------------------------
 * main
 * --------------------------------------------------------- */
int main(void)
{
    int total, leaves;

    printf("이진트리를 괄호 표기법으로 입력하세요 (예: A(B,C(D,E))): ");
    if (fgets(input, MAX_LEN, stdin) == NULL) {
        printf("입력 오류\n");
        return 1;
    }

    removeNewline(input);   /* 개행 문자 제거 */
    removeSpaces(input);    /* 혹시 있을 공백 제거 */

    if (!buildTree()) {
        printf("올바르지 않은 입력입니다.\n");
        return 1;
    }

    total  = countNodes();
    leaves = countLeaves();

    /* [1] 이진트리 출력 */
    printf("\n[이진트리]\n");
    printTree(1, 0);

    /* [2] 트리 정보 */
    printf("\n[트리 정보]\n");
    printf("전체 노드 수: %d\n", total);
    printf("단말 노드 수: %d\n", leaves);
    printf("비단말 노드 수: %d\n", total - leaves);
    printf("트리의 높이: %d (루트를 레벨 1로 계산)\n", getHeight(1));
    printf("트리의 차수: %d\n", getDegree());

    /* [3] 이진트리 형태 */
    printf("\n[이진트리 형태]\n");
    printf("완전 이진트리: %s\n", yesNo(isComplete()));
    printf("포화 이진트리: %s\n", yesNo(isFull()));
    printf("편향 이진트리: %s\n", yesNo(isSkewed()));

    return 0;
}
