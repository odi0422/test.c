/* 시간 복잡도 비교표 출력 */
void printComplexityTable(void)
{
    int widths[3] = {24, 28, 29};
    const char *rows[5][3] = {
        {"작업",                     "배열",                        "연결"},
        {"이름으로 노드 찾기",       "O(M) 완전 O(n), 편향 O(2^n)", "O(n)"},
        {"자식 확인(위치를 알 때)",  "O(1)",                        "O(1)"},
        {"부모 확인(위치를 알 때)",  "O(1)",                        "O(n) 부모 포인터 있으면 O(1)"},
        {"형제 확인(위치를 알 때)",  "O(1)",                        "O(n) 부모를 먼저 찾아야 함"}
    };
    int r, c;

    printf("   "); printBorder(widths, 3);
    for (r = 0; r < 5; r++) {
        printf("   ");
        for (c = 0; c < 3; c++) printCell(rows[r][c], widths[c]);
        printf("|\n");
        if (r == 0) { printf("   "); printBorder(widths, 3); }
    }
    printf("   "); printBorder(widths, 3);
}

/* 두 값 중 더 작은 쪽 이름 */
const char *smallerName(long arrayBytes, long linkedBytes)
{
    return (arrayBytes <= linkedBytes) ? "배열" : "연결 자료구조";
}

